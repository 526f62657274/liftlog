{
  // GitHub Codespaces setup: installs everything and starts the app automatically.
  "name": "Liftlog",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm run dev",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Liftlog app", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss", "oxc.oxc-vscode"]
    }
  }
}
